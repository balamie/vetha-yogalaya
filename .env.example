# Vetha Yogalaya environment configuration
# Copy this file to `.env` and fill in real values (never commit `.env`).

# Formspree (for the Enquire Now form and Newsletter signup)
# Free plan: 50 submissions/month, emailed straight to your inbox. No database.
# 1. Sign up at https://formspree.io
# 2. Create two forms: "Enquiry" and "Newsletter"
# 3. Each form gets an endpoint like: https://formspree.io/f/xyzabcde
VITE_FORMSPREE_ENQUIRY_ENDPOINT=
VITE_FORMSPREE_NEWSLETTER_ENDPOINT=
